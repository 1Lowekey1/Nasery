# Root-level ignores only. backend/.gitignore and frontend/.gitignore cover each
# app's own secrets (.env), dependencies (vendor, node_modules) and build output.

# Settings with secrets, wherever they sit (.env.example stays tracked)
.env
.env.*
!.env.example


# Local AI assistant files and the private context pack
.claude/
.github/
**/CLAUDE.md
**/AGENTS.md
Context Folder/

# Exports
/*.pdf

# Logs, editors and OS files
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db