<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Never load production's frozen settings/routes (scripts/nasery-mode.ps1
             production runs `artisan optimize`): tests use their own cache paths,
             which don't exist, so config is read fresh with the values below. -->
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/testing-config.php" force="true"/>
        <env name="APP_ROUTES_CACHE" value="bootstrap/cache/testing-routes.php" force="true"/>
        <env name="APP_EVENTS_CACHE" value="bootstrap/cache/testing-events.php" force="true"/>
        <!-- Tests expect the local-development addresses, whatever mode .env is in. -->
        <env name="APP_URL" value="http://localhost:8000" force="true"/>
        <env name="FRONTEND_APP_URL" value="http://localhost:3000" force="true"/>
        <env name="FRONTEND_URLS" value="http://localhost:3000" force="true"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:3000,127.0.0.1:3000" force="true"/>
        <env name="SESSION_DOMAIN" value="localhost" force="true"/>
        <env name="SESSION_SECURE_COOKIE" value="false" force="true"/>
        <env name="TRUSTED_PROXIES" value="" force="true"/>
        <env name="DB_PERSISTENT" value="false" force="true"/>
        <env name="APP_DEBUG" value="true" force="true"/>
        <!-- Never write into the live logs (storage/logs/laravel-*.log, security-*.log). -->
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <env name="LOG_SECURITY_PATH" value="storage/logs/testing/security.log" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MEDIA_ROOT" value="storage/framework/testing/media" force="true"/>
        <env name="CACHE_LIMITER_STORE" value="array"/>
        <!-- Tests run against the DB in .env (Supabase) inside transactions that
             are always rolled back. Run via `composer test`, which takes a
             pg_dump backup first. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PAYMONGO_DRIVER" value="fake" force="true"/>
        <env name="PAYMONGO_SECRET_KEY" value="" force="true"/>
        <env name="PAYMONGO_PUBLIC_KEY" value="" force="true"/>
        <env name="PAYMONGO_WEBHOOK_SECRET" value="" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
