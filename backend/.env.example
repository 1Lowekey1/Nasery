# NaSeRy API — environment template. Copy to .env and fill in.
# Never commit real credentials. Local / staging / production each get their
# own Supabase project credentials and PayMongo keys.

APP_NAME=NaSeRy
APP_ENV=local            # local | staging | production
APP_KEY=                 # php artisan key:generate
APP_DEBUG=true           # MUST be false on staging/production
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily          # production containers: stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug          # production: info

# --- Database: Supabase PostgreSQL (session pooler, port 5432) -------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require
# Role every API request switches into so RLS applies (created by 0027).
DB_APP_ROLE=nasery_app
DB_RLS_ENABLED=true

# --- Sanctum SPA auth (cookie session + CSRF) ------------------------------
# Comma-separated Nuxt origins allowed to call the API with credentials.
FRONTEND_URLS=http://localhost:3000
# Hosts (with port) whose requests are treated as first-party SPA requests.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=localhost # production: null when /api is proxied through the frontend origin
SESSION_SECURE_COOKIE=false # production: true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Idempotency -------------------------------------------------------------
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_SECONDS=60

# --- Backups (php artisan nasery:db:backup) ---------------------------------
PG_DUMP_PATH=pg_dump
BACKUP_KEEP=1

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="naserynotifications@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- PayMongo (B10) ----------------------------------------------------------
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"

# Proxies whose X-Forwarded-* headers are trusted (see config/nasery.php). Empty locally.
TRUSTED_PROXIES=

# Rate-limit counter store: "file" for one local server; database/redis when several instances run.
CACHE_LIMITER_STORE=
# Client-side prepared statements (1 round trip per query; recommended behind Supabase pooler).
DB_EMULATE_PREPARES=true

# --- Authentication (B1) -------------------------------------------------------
# SPA base URL that social-login callbacks redirect back to.
FRONTEND_APP_URL=http://localhost:3000
# Social sign-in. Leave empty to hide a provider. Register the callback
# {APP_URL}/api/v1/auth/social/{provider}/callback with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Apple needs HTTPS. Either a client-secret JWT, or key id + team id + .p8 path.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY=

# Payments (B10). Capstone/demo: leave PAYMONGO_DRIVER=fake for the built-in
# simulated checkout, or set "test" with PayMongo TEST keys (sk_test_/pk_test_).
# "live" moves real money and is refused unless APP_ENV=production.
PAYMONGO_DRIVER=fake
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Check-in (B11): a session accepts tickets from this many minutes before it
# starts until it ends.
NASERY_CHECKIN_OPENS_BEFORE_MINUTES=180

# Mail (B13). Real sending over SMTP, e.g.
#   Gmail: MAIL_MAILER=smtp MAIL_HOST=smtp.gmail.com MAIL_PORT=587 MAIL_SCHEME=null
#          MAIL_USERNAME=<your gmail> MAIL_PASSWORD=<16-char app password>
#   Resend: MAIL_HOST=smtp.resend.com MAIL_PORT=587 MAIL_USERNAME=resend MAIL_PASSWORD=<api key>
# MAIL_FROM_ADDRESS must be an address the provider lets you send from.
# Queued mail needs a worker: php artisan queue:work  (and php artisan schedule:work for reminders)
# Rehearsals: only these addresses/@domains receive mail; others are logged as suppressed.
MAIL_ONLY_TO=
NASERY_REMINDER_HOURS=24

# Admin -> Settings -> Delete an account permanently: only these admin e-mails (comma-separated). Empty: nobody.
NASERY_HARD_DELETE_ADMINS=
